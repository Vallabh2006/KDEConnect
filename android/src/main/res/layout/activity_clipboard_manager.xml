<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="org.kde.kdeconnect.plugins.clipboard.ClipboardManagerActivity">

    <include layout="@layout/toolbar" android:id="@+id/toolbar_layout" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Left Side Tabs Navigation Bar -->
        <LinearLayout
            android:id="@+id/sidebar_tabs"
            android:layout_width="68dp"
            android:layout_height="match_parent"
            android:background="?attr/colorSurfaceVariant"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <!-- Tab 1: Local History Side Item -->
            <LinearLayout
                android:id="@+id/tab_item_local"
                android:layout_width="56dp"
                android:layout_height="60dp"
                android:background="@drawable/nav_tab_selected_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/tab_icon_local"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_baseline_content_paste_24"
                    app:tint="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/tab_label_local"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Local"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary" />
            </LinearLayout>

            <View
                android:layout_width="32dp"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="?attr/colorOutlineVariant" />

            <!-- Tab 2: Laptop History Side Item -->
            <LinearLayout
                android:id="@+id/tab_item_laptop"
                android:layout_width="56dp"
                android:layout_height="60dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/tab_icon_laptop"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_device_laptop_32dp"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/tab_label_laptop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Laptop"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="?attr/colorOutlineVariant" />

        <!-- Right Content Area -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <!-- View 1: Local / Shared History Content -->
            <LinearLayout
                android:id="@+id/view_local_history"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="8dp">

                <!-- Quick Action: Active PC Clipboard & Send Box -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/KdeConnectCardStyle.Filled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:cardCornerRadius="14dp"
                    app:contentPadding="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Active PC Clipboard Mini-Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Active Laptop Clipboard"
                                android:textAppearance="?attr/textAppearanceLabelLarge"
                                android:textStyle="bold" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_get_clipboard"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="34dp"
                                android:text="Get PC"
                                android:textSize="11sp"
                                android:paddingStart="4dp"
                                android:paddingEnd="4dp"
                                app:icon="@drawable/ic_action_refresh_24dp"
                                app:iconSize="13dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_copy_to_phone"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="34dp"
                                android:text="Copy"
                                android:textSize="11sp"
                                android:paddingStart="4dp"
                                android:paddingEnd="4dp"
                                app:icon="@drawable/ic_baseline_content_paste_24"
                                app:iconSize="13dp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/text_remote_clipboard"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:background="?attr/colorSurfaceVariant"
                            android:padding="6dp"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textIsSelectable="true"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:text="Laptop clipboard content will appear here..." />

                        <!-- Send Section -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:hint="Type to send..."
                                app:boxBackgroundMode="outline">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/edit_clipboard_text"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="textMultiLine"
                                    android:maxLines="3"
                                    android:paddingTop="6dp"
                                    android:paddingBottom="6dp"
                                    android:textSize="12sp" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_send_clipboard"
                                style="@style/Widget.Material3.Button"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="Send"
                                android:textSize="12sp"
                                app:icon="@drawable/ic_baseline_send_24"
                                app:iconSize="14dp" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_send_phone_clipboard"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Send Latest Phone Clipboard"
                            android:textSize="12sp"
                            app:icon="@drawable/ic_baseline_content_paste_24"
                            app:iconSize="14dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- History List Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp">

                    <TextView
                        android:id="@+id/text_local_history_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Clipboard History"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_clear_local_history"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="Clear"
                        android:textColor="?attr/colorError"
                        android:textSize="11sp"
                        app:icon="@drawable/ic_delete"
                        app:iconTint="?attr/colorError"
                        app:iconSize="13dp" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_local_history"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingTop="2dp"
                    android:paddingBottom="12dp" />

                <TextView
                    android:id="@+id/text_local_history_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:gravity="center"
                    android:text="No clipboard history yet.\nCopied items will appear here."
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?android:attr/textColorSecondary"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- View 2: Laptop Klipper History Content -->
            <LinearLayout
                android:id="@+id/view_laptop_history"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="8dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Laptop Klipper History"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_refresh_laptop_history"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="Refresh"
                        android:textSize="11sp"
                        app:icon="@drawable/ic_action_refresh_24dp"
                        app:iconSize="13dp" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progress_history_loading"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:indeterminate="true"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_laptop_history"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingTop="2dp"
                    android:paddingBottom="12dp" />

                <TextView
                    android:id="@+id/text_laptop_history_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:gravity="center"
                    android:text="No laptop clipboard history found.\nTap Refresh to load."
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?android:attr/textColorSecondary"
                    android:visibility="gone" />

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
