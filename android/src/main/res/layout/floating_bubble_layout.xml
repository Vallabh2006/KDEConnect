<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/floating_bubble_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/floating_bubble_card"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        app:cardCornerRadius="28dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@color/launcher_background"
        app:strokeWidth="1.5dp"
        app:strokeColor="#40FFFFFF">

        <ImageView
            android:id="@+id/floating_bubble_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_device_laptop_32dp"
            app:tint="#FFFFFF"
            android:contentDescription="@string/floating_action_button" />

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
